[Unit]
Description=AI4S 人才地图：每周重新抓取通用 AI 方向数据
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ai4s
Group=ai4s
WorkingDirectory=/opt/ai4s_sourcing
# --refresh ai：全部通用 AI 方向按最新数据重抓（和周一的科学领域错开，避免同一天额度不够）
ExecStart=/opt/ai4s_sourcing/.venv/bin/python run.py --refresh ai
TimeoutStartSec=6h
Nice=10
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ai4s_sourcing
ProtectHome=true
PrivateTmp=true
